# The deployment this app talks to. Public: it is the same URL printed in
# the README, the manifest and hackathon.md, and it carries no secret.
#
# It is committed because without it `vite build` sees
# import.meta.env.VITE_CONVEX_URL as undefined, decides the whole app is
# unreachable dead code, and emits a bundle containing nothing but the
# "not configured" message. CI passes the same variable through
# `convex deploy --cmd-url-env-var-name`, which takes precedence.
VITE_CONVEX_URL=https://qualified-hummingbird-614.convex.cloud
